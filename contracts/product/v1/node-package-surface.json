{
  "schemaVersion": 1,
  "packageName": "krx-cli",
  "moduleFormat": "esm-only",
  "nodeEngine": ">=22 <23 || >=24 <25",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "declarations": {
    "entry": "dist/index.d.ts",
    "generated": [
      "dist/generated/node-operations.d.ts",
      "dist/generated/error-types.d.ts"
    ],
    "sourceImportPrefix": "../../generated/",
    "packageImportPrefix": "./generated/",
    "selfContained": true
  },
  "defaultExport": false,
  "commonJs": false,
  "publicNativeBindingSubpath": false
}
