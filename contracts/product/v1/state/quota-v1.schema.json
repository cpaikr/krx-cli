{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krx-cli.invalid/contracts/state/quota-v1.schema.json",
  "title": "Shared per-credential quota counter",
  "type": "object",
  "required": ["version", "credentials"],
  "properties": {
    "version": { "const": 1 },
    "credentials": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": { "pattern": "^[0-9a-f]{64}$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["date", "count"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{8}$",
          "format": "krx-compact-date"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    }
  }
}
