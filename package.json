{
  "name": "krx-cli",
  "version": "1.8.1",
  "description": "Maintainer workspace for the native KRX CLI, shared Rust SDK, and public Node.js SDK",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compat": "node scripts/compat-certify.mjs",
    "test:node-sdk": "node --test tests/node-sdk/facade.test.mjs",
    "contract:types": "tsc --noEmit --strict --skipLibCheck false --module ESNext --moduleResolution bundler --target ES2022 --types node contracts/product/v1/node-sdk.d.ts contracts/product/v1/consumers/node-positive.ts",
    "contract:rust-probe": "node scripts/rust-vertical-slice.mjs",
    "contract:validate": "redocly lint contracts/krx/openapi.yaml --max-problems 0 && node scripts/contracts.mjs && node scripts/product-contracts.mjs && pnpm contract:rust-probe && pnpm contract:types",
    "contract:artifacts": "node scripts/contracts.mjs --write && node scripts/product-contracts.mjs --write",
    "audit:prod": "pnpm audit --prod --audit-level low",
    "cutover:check": "node scripts/cutover-gate.mjs",
    "lint": "eslint scripts/*.mjs scripts/native-package/*.mjs packages/node/dist/*.js tests/node-sdk/*.mjs tests/scripts/*.ts tests/skill/*.ts contracts/product/v1/consumers/*.ts",
    "format": "prettier --write 'scripts/**/*.mjs' 'tests/**/*.ts' 'contracts/**/*.json'",
    "typecheck": "pnpm contract:types",
    "contract:check": "node scripts/contract-drift.mjs",
    "contract:dry-run": "node scripts/contract-drift.mjs --dry-run",
    "rust:sdk": "cargo fmt --all --check && cargo check --locked --workspace --all-targets --all-features && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings && cargo test --locked --workspace --all-features",
    "rust:security": "cargo deny check advisories bans licenses sources",
    "calendar:check": "node scripts/krx-calendar.mjs --check",
    "calendar:update": "node scripts/krx-calendar.mjs --write",
    "check": "pnpm cutover:check && pnpm contract:validate && pnpm contract:dry-run && pnpm lint && pnpm typecheck && pnpm test:node-sdk && pnpm test",
    "verify": "pnpm check && pnpm rust:sdk && pnpm rust:security && pnpm calendar:check && pnpm audit:prod",
    "release": "release-it"
  },
  "keywords": [
    "krx",
    "korea-exchange",
    "kospi",
    "kosdaq",
    "korean-stock-market",
    "stock",
    "finance",
    "market-data",
    "cli",
    "agent",
    "ai",
    "etf",
    "bond",
    "derivative",
    "한국거래소",
    "주식",
    "시세"
  ],
  "author": "Daniel Jung",
  "license": "MIT",
  "homepage": "https://github.com/cpaikr/krx-cli#readme",
  "bugs": {
    "url": "https://github.com/cpaikr/krx-cli/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kyo504"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpaikr/krx-cli.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.47.0",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/node": "^25.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.0.3",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "hooks": {
      "after:init": [
        "test \"$(git rev-parse HEAD)\" = \"$(git rev-parse '@{upstream}')\"",
        "pnpm verify"
      ]
    },
    "git": {
      "requireBranch": "main",
      "requireUpstream": true,
      "requireCleanWorkingDir": true,
      "tagName": "v${version}",
      "commitMessage": "chore(release): v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits",
        "infile": "CHANGELOG.md",
        "header": "# Changelog",
        "writerOpts": {
          "types": [
            {
              "type": "feat",
              "section": "New Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "refactor",
              "section": "Refactoring"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "build",
              "section": "Build System"
            },
            {
              "type": "ci",
              "section": "Build System"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "revert",
              "section": "Miscellaneous"
            },
            {
              "type": "chore",
              "section": "Miscellaneous"
            }
          ]
        }
      }
    }
  }
}
